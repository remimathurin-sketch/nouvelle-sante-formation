generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enum for user roles
enum UserRole {
  STUDENT
  ADMIN
  COACH
}

// Enum for order status
enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Enum for payment options
enum PaymentOption {
  ONE_TIME    // 1X
  TWO_TIMES   // 2X
  THREE_TIMES // 3X
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  name           String?
  firstName      String?
  lastName       String?
  password       String?
  role           UserRole         @default(STUDENT)
  image          String?
  phone          String?
  address        String?
  city           String?
  postalCode     String?
  country        String?          @default("France")
  emailVerified  DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  accounts       Account[]
  sessions       Session[]
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  orders         Order[]
  badges         UserBadge[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
  @@map("password_reset_tokens")
}

model Formation {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  price       Float
  image       String?
  slug        String   @unique
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  modules     Module[]
  enrollments Enrollment[]
  orders      Order[]

  @@map("formations")
}

model Module {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  emoji       String?  // Emoji icon for the module
  order       Int
  unlockDelay Int      @default(0) // Days after enrollment before module unlocks
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  formationId String
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@index([formationId])
  @@map("modules")
}

model Lesson {
  id        String   @id @default(cuid())
  title     String
  content   String?  @db.Text
  videoUrl  String?
  order     Int
  duration  Int      @default(0) // Duration in seconds
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  moduleId  String
  module    Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress  LessonProgress[]
  resources Resource[]

  @@index([moduleId])
  @@map("lessons")
}

model Resource {
  id        String   @id @default(cuid())
  title     String
  fileUrl   String
  fileType  String
  fileSize  Int
  createdAt DateTime @default(now())

  // Relations
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("resources")
}

model Enrollment {
  id         String   @id @default(cuid())
  enrolledAt DateTime @default(now())
  progress   Float    @default(0) // Percentage 0-100
  expiresAt  DateTime?

  // Relations
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  formationId String
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)

  @@unique([userId, formationId])
  @@index([userId])
  @@index([formationId])
  @@map("enrollments")
}

model LessonProgress {
  id             String    @id @default(cuid())
  completed      Boolean   @default(false)
  completedAt    DateTime?
  watchedSeconds Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model Order {
  id              String        @id @default(cuid())
  amount          Float
  paymentOption   PaymentOption @default(ONE_TIME)
  promoCode       String?
  stripeSessionId String        @unique
  status          OrderStatus   @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  formationId String
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([formationId])
  @@index([stripeSessionId])
  @@map("orders")
}

model Badge {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  image       String
  condition   String   // JSON or description of how to earn
  createdAt   DateTime @default(now())

  // Relations
  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(cuid())
  earnedAt DateTime @default(now())

  // Relations
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId String
  badge   Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@map("user_badges")
}

model PromoCode {
  id             String    @id @default(cuid())
  code           String    @unique
  discountPercent Int      // 0-100
  maxUses        Int?
  usedCount      Int       @default(0)
  validFrom      DateTime  @default(now())
  validUntil     DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@map("promo_codes")
}
